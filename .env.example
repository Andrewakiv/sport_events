SPORT_EVENTS_APP_NAME="Sport Events API"
SPORT_EVENTS_ENVIRONMENT=local
SPORT_EVENTS_DATABASE_URL=postgresql+asyncpg://sport_events:sport_events@localhost:5432/sport_events
SPORT_EVENTS_TEST_DATABASE_URL=postgresql+asyncpg://sport_events:sport_events@localhost:5432/sport_events
# Set locally before calling the football-data.org client; never commit the real token.
FOOTBALL_DATA_API_TOKEN=
# Current Champions League season polled by the sync worker; leave unset to schedule nothing.
# SPORT_EVENTS_CHAMPIONS_LEAGUE_SYNC_SEASON=2026
SPORT_EVENTS_CHAMPIONS_LEAGUE_SYNC_CRON="0 */6 * * *"
SPORT_EVENTS_CHAMPIONS_LEAGUE_SYNC_MAX_ATTEMPTS=3
SPORT_EVENTS_CHAMPIONS_LEAGUE_SYNC_RETRY_BASE_SECONDS=30
SPORT_EVENTS_CHAMPIONS_LEAGUE_SYNC_RETRY_MAX_SECONDS=300
SPORT_EVENTS_SYNC_WORKER_STALLED_AFTER_SECONDS=60

